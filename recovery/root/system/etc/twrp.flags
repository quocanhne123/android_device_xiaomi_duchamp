# Các phân vùng nạp boot và bảo mật hệ thống
/boot            emmc    /dev/block/by-name/boot             flags=slotselect;backup=1;flashimg=1
/vendor_boot     emmc    /dev/block/by-name/vendor_boot      flags=slotselect;backup=1;flashimg=1
/init_boot       emmc    /dev/block/by-name/init_boot        flags=slotselect;backup=1;flashimg=1
/vbmeta          emmc    /dev/block/by-name/vbmeta           flags=slotselect;backup=1;flashimg=1
/vbmeta_system   emmc    /dev/block/by-name/vbmeta_system    flags=slotselect;backup=1;flashimg=1
/vbmeta_vendor   emmc    /dev/block/by-name/vbmeta_vendor    flags=slotselect;backup=1;flashimg=1

# Phân vùng Data và Metadata (Dựa theo định dạng f2fs trong file bạn tìm được)
/metadata        f2fs    /dev/block/by-name/metadata         flags=display="Metadata";backup=1
/data            f2fs    /dev/block/by-name/userdata         flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption

# Các phân vùng lưu trữ cấu hình, IMEI và Sóng (Đặc thù MediaTek)
/protect_f       ext4    /dev/block/by-name/protect1         flags=display="Protect_F";backup=1
/protect_s       ext4    /dev/block/by-name/protect2         flags=display="Protect_S";backup=1
/nvram           emmc    /dev/block/by-name/nvram            flags=display="NVRAM";backup=1
/nvdata          ext4    /dev/block/by-name/nvdata           flags=display="NVData";backup=1;subpartitionof=/nvram
/nvcfg           ext4    /dev/block/by-name/nvcfg            flags=display="NVCfg";backup=1;subpartitionof=/nvram
/persist         ext4    /dev/block/by-name/persist          flags=display="Persist";backup=1

# Khai báo đường dẫn USB OTG khi cắm USB ngoài vào Recovery
/usb_otg         auto    /devices/platform/usb_xhci*         flags=display="USB-OTG";storage;wipeui;removable